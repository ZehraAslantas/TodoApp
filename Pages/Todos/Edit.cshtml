@page "{id:guid}" 
@*id de gözükecek yer bu*@
@model TodoApp.Pages.Todos.EditModel
@{
    ViewData["Title"]= "Görev Düzenle";
}

<h1>Görev Düzenle</h1>
 <form method="post" class="mt-3">
     <input type="hidden" asp-for="Todo.Id" /> @*bunu model olarak tanımlaman lazım .cs dosyasında*@
    <partial name="_TodoForm" for="Todo" /> @* _TodoForm sayfasının html kodlarını aldık buraya.model direktifiyle de Sayfanın tüm modelini (EditModel) değil, onun içindeki Todo nesnesini al ve içindeki kutuları o verilerle doldur.*@
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Güncelle</button>
        <a asp-page="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}